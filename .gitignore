# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map
# ...except our hand-written web bootstrap script (not dart2js output):
!web/flutter_bootstrap.js
# ...and the security-rules test suite, which is genuinely written in
# JavaScript because Firebase's rules-unit-testing library only exists
# there. Without this negation the whole suite is silently untracked.
!test_rules/*.js
# ...and the Cloud Functions, likewise genuinely JavaScript. This one
# caught us out: `git add functions/` reported success and committed the
# package.json alone, leaving a deploy surface with no code in it.
!functions/*.js
!functions/test/*.js

node_modules/

# Vite's output. Deliberately not `build/`, which is Flutter's and is
# already ignored above - keeping them apart means either toolchain can
# be run without clobbering the other's artifacts.
dist/

.flutter-plugins
.flutter-plugins-dependencies

# Firebase emulator local artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# IDE files regenerated by `flutter create`
.idea/
*.iml
